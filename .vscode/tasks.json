{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Functions Host",
      "type": "shell",
      "command": "func start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "azureFunctions",
        "pattern": [
          {
            "regexp": ".*"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Worker process started and initialized.*",
          "endsPattern": ".*Host started.*"
        }
      }
    }
  ]
}
